<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ebook2ttsLocal" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/bg</item>
        <item name="colorOnPrimary">@color/bg</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/on_bg</item>
        <item name="actionBarStyle">@style/Widget.E2t.ActionBar</item>
    </style>

    <style name="Widget.E2t.ActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="android:background">@color/bg</item>
        <item name="background">@color/bg</item>
        <item name="titleTextColor">@color/on_bg</item>
    </style>

    <style name="Btn.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/card_stroke</item>
        <item name="android:textColor">@color/on_bg</item>
    </style>
    <style name="Btn.Danger" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/error</item>
    </style>
</resources>
